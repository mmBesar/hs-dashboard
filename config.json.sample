{
  "_comment": "hs-dashboard — copy to config.json and edit. All hardware fields auto-detect if null.",

  "server": {
    "name": "hs2",
    "_comment_name": "Short name for logo. Last character gets accent color.",
    "fqdn": "hs2.example.com",
    "ip": "192.168.1.2",
    "dns": null,
    "_comment_dns": "DNS server IP shown in system section. null to hide.",
    "description": "Home server"
  },

  "hardware": {
    "_comment": "All fields auto-detected if null. Set to override.",
    "board": null,
    "cpu": null,
    "arch": null,
    "ram": null,
    "storage": null,
    "os": null,
    "kernel": null
  },

  "logo": {
    "image": null,
    "_comment_image": "Optional image filename in www/. null = text logo.",
    "height": 48
  },

  "thermal": {
    "_comment": "Leave zones empty [] for auto-detection. Specify zones to override labels.",
    "zones": []
  },

  "_comment_thermal_manual": {
    "zones": [
      {"path": "/sys/class/thermal/thermal_zone0/temp", "label": "CPU", "description": "main cluster"},
      {"path": "/sys/class/thermal/thermal_zone1/temp", "label": "GPU", "description": "graphics"}
    ]
  },

  "display": {
    "timezone": "UTC",
    "_comment_timezone": "IANA timezone e.g. Europe/London, America/New_York, Africa/Cairo",
    "theme": "auto",
    "_comment_theme": "auto, light, or dark",
    "scale": 1.2,
    "_comment_scale": "UI scale: 1.0=normal 1.2=larger 1.4=largest",
    "refresh_stats_ms": 5000,
    "refresh_status_ms": 30000,
    "tile_width": 200,
    "_comment_tile_width": "Minimum tile width in px for stat/service cards. Lower = smaller tiles, more per row. Try 150-160 for a dense view.",
    "show_urls": true,
    "_comment_show_urls": "Set false to hide the URL line on service cards for an even more compact grid."
  }
}
