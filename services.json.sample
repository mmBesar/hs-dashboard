      "name": "hs2",
      "label": "This server",
      "ip": "192.168.1.2",
      "services": [
        {
          "name": "Pi-hole",
          "desc": "Network-wide ad blocking & DNS",
          "url": "https://pihole.hs2.example.com/admin",
          "display": "pihole.hs2.example.com",
          "accent": "#a6da95",
          "icon": "dns"
        },
        {
          "name": "Vaultwarden",
          "desc": "Self-hosted password manager",
          "url": "https://vault.hs2.example.com",
          "display": "vault.hs2.example.com",
          "accent": "#eed49f",
          "icon": "vault",
          "disabled": true
        }
      ]
    },
    {
      "name": "hs",
      "label": "Main server",
