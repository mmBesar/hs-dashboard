{
  "_comment": "hs-dashboard services — copy to services.json and edit",
  "_comment_icons": "Icons: dns proxy router wifi shield server nas database file cloud download video audio image tv camera rss cal mail vault git book chart monitor terminal code settings lock share search printer home disk gpu",
  "_comment_accent": "Catppuccin colors: mauve #c6a0f6 · green #a6da95 · teal #8bd5ca · sky #91d7e3 · peach #f5a97f · yellow #eed49f · pink #f5bde6 · lavender #b7bdf8 · blue #8aadf4 · red #ed8796",

  "servers": [
